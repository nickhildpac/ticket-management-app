# ============================================
# SECURITY WARNING: Never commit .env to git!
# ============================================
# Copy this file to .env and update with your values.
# Loaded by docker compose (infra/compose/docker-compose.yml).

# ============================================
# Shared
# ============================================
# IMPORTANT: Generate a secure JWT secret for production! Use: openssl rand -base64 32
# Shared by the Go ticket-service and the AI service (which mints service tokens with it).
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters-long

# Environment. Use "production" with a strong JWT_SECRET outside local development.
APP_ENV=local

# Cookie domain for the ticket-service auth cookies.
COOKIE_DOMAIN=localhost

# ============================================
# ticket-service (Go, authoritative — port 8080)
# ============================================
# DB_ADDR is set by compose for the container; shown here for local runs.
# DB_ADDR=postgres://postgres:postgres@localhost:5432/ticket_management?sslmode=disable

# ============================================
# web (Vite/React) — build-time API base URL (points at the Go ticket-service)
# ============================================
WEB_API_URL=http://localhost:8080

# ============================================
# ai-service (Python RAG/triage — port 8081, profile "ai")
# ============================================
# SQLAlchemy URL (compose overrides for the container).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ticket_management
REDIS_URL=redis://localhost:6379/0
TICKET_SERVICE_URL=http://localhost:8080

# Anthropic API key for the triage agent (required to run the AI worker).
ANTHROPIC_API_KEY=
# Triage model + safety gate.
TRIAGE_MODEL=claude-opus-4-8
AUTO_ANSWER_CONFIDENCE_THRESHOLD=0.75

# Service account the AI worker uses to call back into the ticket API. Defaults
# match the seeded admin service account (ticket-service migration 000013). It
# must be admin so it can comment on tickets it isn't assigned to; iss/aud must
# match the ticket-service config.
AI_SERVICE_ACCOUNT_ID=00000000-0000-4000-8000-0000000000a1
AI_SERVICE_ACCOUNT_ROLE=admin
JWT_ISSUER=example.com
JWT_AUDIENCE=example.com

# ============================================
# Database
# ============================================
POSTGRES_DB=ticket_management
POSTGRES_USER=postgres
# IMPORTANT: Change this password in production! Use: openssl rand -base64 16
POSTGRES_PASSWORD=postgres

# ============================================
# Monitoring (profile "obs")
# ============================================
GRAFANA_PASSWORD=admin
