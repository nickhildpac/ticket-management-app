# ============================================
# SECURITY WARNING: Never commit .env to git!
# ============================================
# Copy this file to .env and update with your values.
# Loaded by docker compose (infra/compose/docker-compose.yml).

# ============================================
# Shared
# ============================================
# Environment. Outside local/test the services refuse weak secrets and plain-http
# Keycloak issuers, so set this to "production" in a real deployment.
APP_ENV=local

COOKIE_DOMAIN=localhost

# ============================================
# Keycloak (identity provider — admin console on port 8090)
# ============================================
# Authentication is delegated to Keycloak (docs/adr/0003-keycloak-authentication.md).
# Neither Go service holds a signing key; both validate tokens against the realm's JWKS.

# Bootstrap admin for the Keycloak console. Change these outside local development.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The URL the *browser* uses. It ends up in every token's `iss`, so services
# validate against it. Must be https outside local/test.
KEYCLOAK_PUBLIC_URL=http://localhost:8090
KEYCLOAK_REALM=ticket-management

# Resource-server audience stamped into tokens by the `ticket-audience` client
# scope and required by both APIs. Leaving it empty accepts any token the realm
# issues to any client — don't.
KEYCLOAK_AUDIENCE=ticket-service

# Public SPA client (Authorization Code + PKCE). Served to the browser by
# GET /api/v1/auth/config.
KEYCLOAK_WEB_CLIENT_ID=ticket-web

# Optional: lets an admin change a user's realm role through the app's admin
# panel instead of the Keycloak console. Needs a confidential client whose
# service account holds the realm-management roles view-users + manage-users.
# Without these, role changes return 501 rather than being written locally and
# then silently reverted on the user's next login.
KEYCLOAK_ADMIN_CLIENT_ID=ticket-service
KEYCLOAK_ADMIN_CLIENT_SECRET=ticket-service-dev-secret

# ============================================
# ticket-service (Go, authoritative — port 8080)
# ============================================
# DB_ADDR is set by compose for the container; shown here for local runs.
# DB_ADDR=postgres://postgres:postgres@localhost:5432/ticket_management?sslmode=disable
#
# Compose sets these two; only needed when running the service outside Docker:
# KEYCLOAK_ISSUER_URL=http://localhost:8090/realms/ticket-management
# KEYCLOAK_INTERNAL_ISSUER_URL=   # leave unset outside Docker

# ============================================
# web (Vite/React) — build-time API base URL (points at the Go ticket-service)
# ============================================
WEB_API_URL=http://localhost:8080

# ============================================
# ai-service (Go RAG/triage — port 8081, profile "ai")
# ============================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ticket_management
REDIS_URL=redis://localhost:6379/0
TICKET_SERVICE_URL=http://localhost:8080

# Anthropic API key for the triage agent (required to run the AI worker).
ANTHROPIC_API_KEY=
# Triage model + safety gate.
TRIAGE_MODEL=claude-opus-4-8
AUTO_ANSWER_CONFIDENCE_THRESHOLD=0.75

# Confidential Keycloak client the triage worker uses (client_credentials) to
# call back into the ticket API. Its service account holds the `admin` realm
# role, because it comments on tickets it isn't assigned to. The dev secret is
# the one baked into infra/keycloak/realm-export.json; generate a real one for
# any deployed environment (openssl rand -base64 32).
AI_KEYCLOAK_CLIENT_ID=ai-service
AI_KEYCLOAK_CLIENT_SECRET=ai-service-dev-secret

# ============================================
# Database
# ============================================
POSTGRES_DB=ticket_management
POSTGRES_USER=postgres
# IMPORTANT: Change this password in production! Use: openssl rand -base64 16
POSTGRES_PASSWORD=postgres

# ============================================
# Monitoring (profile "obs")
# ============================================
GRAFANA_PASSWORD=admin
