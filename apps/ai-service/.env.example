APP_NAME=Ticket Management AI Service
APP_ENV=local
API_V1_PREFIX=/api/v1
PORT=8081

# A plain postgres:// DSN. A SQLAlchemy-style DATABASE_URL carried over from the
# previous Python service (postgresql+psycopg://...) is normalised automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticket_management

# Shared secret with the Go ticket-service: it signs the callback token the
# worker uses and verifies the token on this service's own endpoints.
JWT_SECRET=local-dev-only-secret
JWT_ISSUER=example.com
JWT_AUDIENCE=example.com

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

REDIS_URL=redis://localhost:6379/0
TICKET_SERVICE_URL=http://localhost:8080

# Service account the worker comments as. Seeded by ticket-service migration
# 000013; must be an admin (only admins may comment on unassigned tickets).
AI_SERVICE_ACCOUNT_ID=00000000-0000-4000-8000-0000000000a1
AI_SERVICE_ACCOUNT_ROLE=admin

# Anthropic API key for the triage agent (required to run the AI worker).
ANTHROPIC_API_KEY=
# Triage model + safety gate.
TRIAGE_MODEL=claude-opus-4-8
AUTO_ANSWER_CONFIDENCE_THRESHOLD=0.75
# Max model turns in the agentic triage loop before we fail safe and escalate.
TRIAGE_MAX_ITERATIONS=6

# OpenAI API key for RAG embeddings (kb_chunks). Falls back to the offline
# hashing embedder when unset — fine for tests, not for real retrieval quality.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(N) width in migrations/000001_kb_chunks.up.sql.
EMBEDDING_DIM=384

# Hybrid retrieval: semantic + keyword (RRF) then OpenRouter Cohere re-rank.
OPENROUTER_API_KEY=
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_RERANK_POOL=10
RRF_K=60
CROSS_ENCODER_MODEL=cohere/rerank-v3.5

# Redis Streams consumer group + this replica's consumer name (set per replica
# when scaling the worker horizontally).
CONSUMER_GROUP=ai-triage
CONSUMER_NAME=worker-1
