APP_NAME=Ticket Management API (FastAPI)
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ticket_management
JWT_SECRET=local-dev-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=24
REFRESH_COOKIE_NAME=tapp-refresh_token
REFRESH_COOKIE_PATH=/
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Anthropic API key for the triage agent (required to run the AI worker).
ANTHROPIC_API_KEY=
# Triage model + safety gate.
TRIAGE_MODEL=claude-sonnet-5
AUTO_ANSWER_CONFIDENCE_THRESHOLD=0.75

# OpenAI API key for RAG embeddings (kb_chunks). Falls back to the offline
# HashingEmbedder when unset — fine for tests, not for real retrieval quality.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Hybrid retrieval: semantic + keyword (RRF) then OpenRouter Cohere re-rank.
OPENROUTER_API_KEY=
RAG_TOP_K=3
RAG_CANDIDATE_K=20
RAG_RERANK_POOL=10
RRF_K=60
CROSS_ENCODER_MODEL=cohere/rerank-v3.5
