{
  "realm": "ticket-management",
  "displayName": "Ticket Management",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access: manage users, assign tickets, change priority, delete tickets, ingest KB documents.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "agent",
        "description": "Support agent: works tickets assigned to them.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "user",
        "description": "End user: raises and follows their own tickets.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-ticket-management",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "user"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ticket-management",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "ticket-web",
      "name": "Ticket Management SPA",
      "description": "Browser SPA. Authorization Code + PKCE (S256). Implicit and direct-grant are disabled deliberately.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*",
        "access.token.lifespan": "300"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "protocolMappers": [
        {
          "name": "ticket-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticket-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ai-service",
      "name": "AI Triage Service",
      "description": "Confidential client. The triage worker uses client_credentials to call back into ticket-service; its service account holds the admin realm role because it comments on tickets it is not assigned to.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "ai-service-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "ticket-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticket-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ticket-service",
      "name": "Ticket Service (resource server)",
      "description": "The API's identity in the realm: the audience tokens are stamped with, and the confidential client whose service account writes realm role changes back via the Admin API (admin panel role edits). It never initiates a user-facing flow.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "ticket-service-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
